# ---- Robinhood (unofficial API via robin_stocks) ----
RH_USERNAME=you@example.com
RH_PASSWORD=change-me
# Base32 secret from Robinhood's authenticator-app MFA setup (optional but strongly recommended
# so the agent can log in unattended). Leave blank to be prompted / approve in the app.
RH_MFA_SECRET=

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---- Execution ----
# live  = real orders on your Robinhood account, placed autonomously
# paper = simulated fills against live Robinhood quotes
TRADING_MODE=live
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA
CYCLE_MINUTES=30

# ---- Hard risk limits (enforced in code; Claude cannot override these) ----
MAX_ORDER_USD=200            # largest single order
MAX_POSITION_PCT=0.20        # max share of equity in any one symbol
MIN_CASH_USD=100             # never spend below this cash balance
MAX_ORDERS_PER_DAY=6
MAX_DAILY_LOSS_PCT=0.03      # halt trading for the day after a 3% equity drawdown
MIN_CONFIDENCE=0.6           # ignore Claude proposals below this confidence
KILL_SWITCH_FILE=data/KILL   # touch this file to halt all trading immediately

DATA_DIR=data
PAPER_STARTING_CASH=10000
